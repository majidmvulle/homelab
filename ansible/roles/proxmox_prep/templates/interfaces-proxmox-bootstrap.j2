# Bootstrap reference fragment for Proxmox networking.
# Safe first stage: keep current flat-LAN management while enabling the LAN trunk bridge
# and parking the dedicated WAN NIC on its own bridge.
# Review from console access before merging into /etc/network/interfaces.

auto {{ proxmox_lan_physical_nic }}
iface {{ proxmox_lan_physical_nic }} inet manual

auto {{ proxmox_wan_physical_nic }}
iface {{ proxmox_wan_physical_nic }} inet manual

auto {{ proxmox_lan_bridge_name }}
iface {{ proxmox_lan_bridge_name }} inet static
    address {{ ansible_host }}/24
    gateway {{ legacy_flat_lan_gateway }}
    bridge-ports {{ proxmox_lan_physical_nic }}
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids {{ proxmox_trunk_vlans | join(' ') }}

auto {{ proxmox_wan_bridge_name }}
iface {{ proxmox_wan_bridge_name }} inet manual
    bridge-ports {{ proxmox_wan_physical_nic }}
    bridge-stp off
    bridge-fd 0
