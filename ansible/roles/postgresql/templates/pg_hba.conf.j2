# PostgreSQL Client Authentication Configuration File
# ===================================================

# TYPE  DATABASE        USER            ADDRESS                 METHOD

# "local" is for Unix domain socket connections only
local   all             all                                     peer
# IPv4 local connections:
host    all             all             127.0.0.1/32            scram-sha-256
# IPv6 local connections:
host    all             all             ::1/128                 scram-sha-256

# Repmgr user access from all repmgr nodes (primary and standbys)
# The repmgr user needs to connect to the repmgr_db and also for replication purposes.
{% for host_item in groups['postgres_all'] %}
host    {{ repmgr_db }}   {{ repmgr_user }}  {{ hostvars[host_item]['node_ip'] }}/32   scram-sha-256
{% endfor %}

{% for host_item in groups['postgres_all'] %}
host    replication     {{ repmgr_user }}  {{ hostvars[host_item]['node_ip'] }}/32   scram-sha-256
{% endfor %}

# Allow replication connections from other PostgreSQL servers in the cluster (postgres OS user)
# This allows the 'postgres' user on one server to connect as a replication client to another.
{% for host_item in groups['postgres_all'] %}
host    replication     {{ pg_user }}     {{ hostvars[host_item]['node_ip'] }}/32   scram-sha-256
{% endfor %}

