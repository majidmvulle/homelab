{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "automerge": false,
  "packageRules": [
    {
      "description": "Review Helm patch and minor updates",
      "matchManagers": ["helmv3"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "Review container-image patch and minor updates",
      "matchManagers": ["helm-values"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "Do not open major-version updates automatically",
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
